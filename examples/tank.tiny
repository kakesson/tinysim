// Steady-state initialization: the initial state is COMPUTED, not given.
model Tank
  parameter Real A = 1.0    "cross section [m2]";
  parameter Real k = 0.5    "outflow coefficient";
  parameter Real qin = 0.3  "inflow [m3/s]";
  Real h "level [m]";
  Real q "outflow [m3/s]";
initial equation
  der(h) = 0;               // start in steady state
equation
  A * der(h) = qin - q;
  q = k * sqrt(h);
end Tank;


contract StaysAtTheSteadyLevel for Tank
  "started in steady state, the level must not drift"
assume
  qin > 0 and k > 0;
guarantee
  always abs(q - qin) <= 1e-6;            // inflow and outflow stay balanced
  h stays within [0.35, 0.37];
end StaysAtTheSteadyLevel;
