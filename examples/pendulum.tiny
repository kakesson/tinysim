// A nonlinear pendulum in angular coordinates: index-1, two states.
model Pendulum
  parameter Real m = 1.0   "mass [kg]";
  parameter Real L = 1.0   "length [m]";
  parameter Real g = 9.81  "gravity [m/s2]";
  parameter Real d = 0.1   "viscous damping [N.m.s]";
  Real phi(start = 1.0) "angle from vertical [rad]";
  Real w(start = 0.0)   "angular velocity [rad/s]";
equation
  der(phi) = w;
  m * L * L * der(w) = -m * g * L * sin(phi) - d * w;
end Pendulum;


contract SwingsAndSettles for Pendulum
  "a damped pendulum never gains energy, and its swing dies away"
assume
  d > 0 and m > 0 and L > 0;              // there is damping, and a real pendulum
guarantee
  always abs(phi) <= 1.2;                 // it never swings higher than it started
  always m * g * L * (1 - cos(phi)) + m * L ^ 2 * w ^ 2 / 2 <= 4.51;
  after 8 always abs(phi) <= 0.7;         // and by then it is nearly at rest
end SwingsAndSettles;
