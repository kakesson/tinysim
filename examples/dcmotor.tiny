// Two physical domains joined by one component: the classic DC motor.
// Shows that the SAME connect() rules give Kirchhoff's laws on the electrical
// side and Newton's third law on the mechanical side.

connector Pin
  Real v;
  flow Real i;
end Pin;

connector Flange
  Real phi      "angle [rad]";
  flow Real tau "torque INTO the component [N.m]";
end Flange;

partial model OnePort
  Pin p, n;
  Real v, i;
equation
  v = p.v - n.v;
  i = p.i;
  p.i + n.i = 0;
end OnePort;

model Resistor
  extends OnePort;
  parameter Real R = 0.5;
equation
  v = R * i;
end Resistor;

model Inductor
  extends OnePort;
  parameter Real L = 0.05;
equation
  L * der(i) = v;
end Inductor;

model ConstantVoltage
  extends OnePort;
  parameter Real V = 24;
equation
  v = V;
end ConstantVoltage;

model Ground
  Pin p;
equation
  p.v = 0;
end Ground;

model EMF "electro-mechanical energy conversion"
  extends OnePort;
  parameter Real k = 0.1 "torque constant [N.m/A]";
  Flange flange;
  Real w "shaft speed [rad/s]";
equation
  w = der(flange.phi);
  v = k * w;              // back-EMF
  flange.tau = -k * i;    // torque delivered to the shaft
end EMF;

model Inertia
  parameter Real J = 0.02 "moment of inertia [kg.m2]";
  parameter Real d = 0.01 "viscous friction [N.m.s]";
  Flange flange;
  Real phi(start = 0), w(start = 0);
equation
  phi = flange.phi;
  der(phi) = w;
  J * der(w) = flange.tau - d * w;
end Inertia;

model DCMotor
  ConstantVoltage src(V = 24);
  Resistor r(R = 0.5);
  Inductor l(L = 0.05, i(start = 0));
  EMF emf(k = 0.1);
  Inertia load(J = 0.02, d = 0.01);
  Ground gnd;
equation
  connect(src.p, r.p);
  connect(r.n, l.p);
  connect(l.n, emf.p);
  connect(emf.n, src.n);
  connect(src.n, gnd.p);
  connect(emf.flange, load.flange);
end DCMotor;


// ---------------------------------------------------------------------------
// Contracts, at two levels. The component contracts are checked for each
// instance, under the environment the system actually gave it, which is what
// separates "the system misused the component" from "the component broke its
// promise". Run `tinysim run dcmotor.tiny --stop 3 --contracts`.
// ---------------------------------------------------------------------------
contract WithinCurrentLimit for Inductor
  "the winding tolerates this voltage, and keeps its current bounded"
assume
  always abs(v) <= 30;
guarantee
  always abs(i) <= 60;
end WithinCurrentLimit;

contract SpeedIsBounded for Inertia
  "the load must not be driven past its mechanical limit"
assume
  always abs(flange.tau) <= 5;
guarantee
  always abs(w) <= 200;
end SpeedIsBounded;

contract ReachesSpeed for DCMotor
  "the shaft reaches its rated speed quickly, and settles there"
assume
  always src.V >= 20 and src.V <= 28;
guarantee
  eventually within [0, 2] load.w >= 150;
  after 2 load.w settles to 160 within 8;
  always abs(l.i) <= 60;
end ReachesSpeed;
