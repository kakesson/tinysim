// ---------------------------------------------------------------------------
// A minimal electrical component library, in the style of Modelica.Electrical
// ---------------------------------------------------------------------------

connector Pin
  Real v        "electrical potential [V]";
  flow Real i   "current INTO the component [A]";
end Pin;

partial model OnePort "component with two pins, same current in and out"
  Pin p, n;
  Real v "voltage drop p.v - n.v [V]";
  Real i "current from p to n [A]";
equation
  v = p.v - n.v;
  i = p.i;
  p.i + n.i = 0;
end OnePort;

model Resistor
  extends OnePort;
  parameter Real R = 100 "resistance [Ohm]";
equation
  v = R * i;
end Resistor;

model Capacitor
  extends OnePort;
  parameter Real C = 1e-3 "capacitance [F]";
equation
  C * der(v) = i;
end Capacitor;

model Inductor
  extends OnePort;
  parameter Real L = 1e-3 "inductance [H]";
equation
  L * der(i) = v;
end Inductor;

model ConstantVoltage
  extends OnePort;
  parameter Real V = 10 "source voltage [V]";
equation
  v = V;
end ConstantVoltage;

model Ground
  Pin p;
equation
  p.v = 0;
end Ground;

// ---------------------------------------------------------------------------
// A charging RC circuit: the "hello world" of acausal modeling
// ---------------------------------------------------------------------------
model RCCircuit
  ConstantVoltage src(V = 10);
  Resistor        r(R = 100);
  Capacitor       c(C = 1e-3, v(start = 0));
  Ground          gnd;
equation
  connect(src.p, r.p);
  connect(r.n, c.p);
  connect(c.n, src.n);
  connect(src.n, gnd.p);
end RCCircuit;


// ---------------------------------------------------------------------------
// What this circuit promises. `tinysim run electrical.tiny --contracts`
// ---------------------------------------------------------------------------
contract WithinItsRating for Resistor
  "a resistor of this library is rated for two watts"
assume
  always abs(v) <= 25;                    // it is a low-voltage part
guarantee
  always abs(v * i) <= 2;
end WithinItsRating;

contract ChargesInTime for RCCircuit
  "the capacitor reaches 95 % of the source voltage within half a second"
assume
  always src.V >= 5 and src.V <= 15;      // the source stays in its rated range
guarantee
  eventually within [0, 0.5] c.v >= 0.95 * src.V;
  always c.v <= src.V;                    // and it never overshoots
  never abs(r.i) > 0.2;                   // nor draws more than 200 mA
end ChargesInTime;
